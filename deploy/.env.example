# 公测部署环境变量示例
# 使用前复制为项目根目录 .env，并把所有 CHANGE_ME 替换为真实值。

USE_MOCK_DB=false
PORT=8080

# 生成方式：openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_JWT_SECRET

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhixiang_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD
DB_NAME=liquor_inventory

# Docker MySQL root 密码，仅 docker compose 场景使用
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_ROOT_PASSWORD

# 域名与证书
DOMAIN=example.com
ADMIN_EMAIL=ops@example.com

# 微信支付，公测未接真实支付时可留空
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
