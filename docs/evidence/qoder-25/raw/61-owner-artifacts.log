# 产物口径 app-mobile/dist/build/<platform>

$ ls -d app-mobile/dist/build/*
app-mobile/dist/build/app
app-mobile/dist/build/h5
app-mobile/dist/build/mp-weixin

## H5
$ ls app-mobile/dist/build/h5/assets | grep -E 'ai-chat|custom-tab-bar'
ai-chat-DQJUtvTH.css
custom-tab-bar-BGWXZz6J.css
custom-tab-bar.C-imRqs-.js
pages-ai-chat-ai-chat.BieDSea6.js
GREP_EXIT=0
$ rg -c '停止生成' app-mobile/dist/build/h5/assets/pages-ai-chat-ai-chat.*.js
HIT=1 RG_EXIT=0
$ rg -c 'custom-tab-bar' app-mobile/dist/build/h5/assets/pages-ai-chat-ai-chat.*.js
HIT=1 RG_EXIT=0
$ rg -l 'getFileSystemManager' app-mobile/dist/build/h5/assets/*.js   # 期望零命中
RG_EXIT=1
H5_MP_API_FILES=0

