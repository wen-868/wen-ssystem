$ rg -n qoder25AntiFsProbe app-mobile/src/pages/ai-chat/ai-chat.vue   # RG_EXIT=1 零命中（注入行已消失）
$ git diff -- app-mobile/src/pages/ai-chat/ai-chat.vue | wc -c   # =0（与已提交态逐字节口径一致）
$ git status --porcelain   # 只剩 ?? docs/evidence/qoder-25/
