{
    "name" : "智享全链",
    "appid" : "__UNI__E395BAE",
    "description" : "智享全链管理系统",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    "vueVersion" : "3",
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        "modules" : {
            "Barcode" : {},
            "Speech" : {},
            "Share" : {
                "description" : "分享"
            }
        },
        "distribute" : {
            "android" : {
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.INTERNET\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.BLUETOOTH\"/>",
                    "<uses-permission android:name=\"android.permission.BLUETOOTH_ADMIN\"/>",
                    "<uses-permission android:name=\"android.permission.BLUETOOTH_SCAN\"/>",
                    "<uses-permission android:name=\"android.permission.BLUETOOTH_CONNECT\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>"
                ],
                "packagename" : "com.zhixiang.app",
                "minSdkVersion" : 21,
                "targetSdkVersion" : 33,
                "abiFilters" : [ "armeabi-v7a", "arm64-v8a" ]
            },
            "ios" : {
                "appid" : "com.zhixiang.app",
                "dSYMs" : false,
                "privacyDescription" : {
                    "NSCameraUsageDescription" : "用于扫描商品条码与二维码（扫码入库、扫码核销优惠券、扫码查溯源），以及在门店现场拍摄销售小票、盘点与损耗单据照片并上传留存。",
                    "NSMicrophoneUsageDescription" : "用于AI经营助手语音输入：按住说话录制您的口述内容并上传，转写为文字后生成经营问答与开单草稿。",
                    "NSPhotoLibraryUsageDescription" : "用于从相册选取已有照片，上传为商品主图与详情图、门店与个人头像、损耗及采购单据凭证、客户对账附件。",
                    "NSLocationWhenInUseUsageDescription" : "用于在App运行期间定位您所在的门店，以便按当前门店展示库存、销售与配送数据，并核对门店档案中登记的门店经纬度。",
                    "NSBluetoothAlwaysUsageDescription" : "用于搜索并连接门店的蓝牙热敏打印机，将销售单、退货单、收款单等小票直接打印输出；连接与打印在App使用期间进行。",
                    "NSSpeechRecognitionUsageDescription" : "用于AI经营助手把您的语音转写为文字（例如“给张三开一箱52度白酒”），转写结果仅用于生成问答回复与单据草稿。"
                }
            },
            "icons" : {
                "android" : {
                    "hdpi" : "static/icons/android/72.png",
                    "xhdpi" : "static/icons/android/96.png",
                    "xxhdpi" : "static/icons/android/144.png",
                    "xxxhdpi" : "static/icons/android/192.png"
                },
                "ios" : {
                    "appstore" : "static/icons/ios/appstore-1024.png",
                    "iphone" : {
                        "app@2x" : "static/icons/ios/app-120.png",
                        "app@3x" : "static/icons/ios/app-180.png",
                        "spotlight@2x" : "static/icons/ios/spotlight-80.png",
                        "spotlight@3x" : "static/icons/ios/spotlight-120.png"
                    }
                }
            },
            "sdkConfigs" : {
                "share" : {},
                "speech" : {}
            },
            "plugins" : {
                "PrintManager" : {
                    "version" : "1.0.0",
                    "provider" : "阿澈"
                },
                "ZXing-Scanner" : {
                    "version" : "1.0.0",
                    "provider" : "阿澈"
                }
            },
            "safeguard" : true,
            "splashscreen" : {
                "useOriginalMsgbox" : true
            }
        },
        "networkTimeout" : {
            "request" : 30000,
            "connectSocket" : 30000,
            "uploadFile" : 60000,
            "downloadFile" : 60000
        }
    },
    "h5" : {
        "title" : "智享全链",
        "optimization" : {
            "treeShaking" : {
                "enable" : false
            }
        }
    },
    "mp-weixin" : {
        "appid" : "wx3ea76428aa15cec7",
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "postcss" : true,
            "minified" : true
        },
        "usingComponents" : true,
        "permission" : {
            "scope.record" : {
                "desc" : "用于AI经营助手语音输入：按住说话录制您的口述内容并转为文字，以便生成经营问答与开单草稿。"
            }
        },
        "requiredPrivateInfos" : []
    },
    "locale" : "zh-Hans"
}
