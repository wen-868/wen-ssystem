# --- 服务器 ---
SERVER_IP=159.75.153.59
DOMAIN=onepan.cn

# --- 后端 ---
PORT=8080
NODE_ENV=production
USE_MOCK_DB=false
JWT_SECRET=zhixiang_liquor_jwt_secret_2026_secure

# --- MySQL 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhixiang_app
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=liquor_inventory
MYSQL_ROOT_PASSWORD=<YOUR_ROOT_PASSWORD>

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- 域名配置 ---
API_DOMAIN=api.onepan.cn
ADMIN_DOMAIN=admin.onepan.cn
MERCHANT_DOMAIN=m.onepan.cn
STORE_DOMAIN=store.onepan.cn

# --- 前端 API 地址 ---
VITE_API_BASE=https://api.onepan.cn/api

# --- 微信小程序（待填写） ---
WECHAT_APP_ID=<YOUR_WECHAT_APP_ID>
WECHAT_APP_SECRET=<YOUR_WECHAT_APP_SECRET>

# --- 微信支付（待填写） ---
WECHAT_MCH_ID=<YOUR_MCH_ID>
WECHAT_PAY_SERIAL_NO=<YOUR_SERIAL_NO>
WECHAT_PAY_PRIVATE_KEY_PATH=/etc/ssl/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=<YOUR_API_V3_KEY>
