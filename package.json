{
  "name": "zhixiang-marketing-system",
  "private": true,
  "version": "0.1.0",
  "description": "智享全链管理系统第 1 阶段 MVP 多端工程骨架",
  "workspaces": [
    "backend",
    "admin-web",
    "store-terminal",
    "merchant-mobile",
    "website"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:admin": "npm --workspace admin-web run dev",
    "dev:store": "npm --workspace store-terminal run dev",
    "dev:merchant": "npm --workspace merchant-mobile run dev",
    "dev:website": "npm --workspace website run dev",
    "build": "npm --workspaces run build",
    "build:merchant": "npm --workspace merchant-mobile run build",
    "build:website": "npm --workspace website run build",
    "build:store-beta": "node scripts/build-store-beta.mjs",
    "build:mobile-beta": "node scripts/build-mobile-beta.mjs",
    "build:beta": "npm run build:store-beta && npm run build:mobile-beta",
    "test:flow": "node scripts/self-test.mjs",
    "test:backend": "npm --workspace backend test",
    "test:store": "node scripts/quick-store-test.mjs",
    "test:ui": "node scripts/ui-contract-test.mjs",
    "test:qa": "node scripts/qa-regression-test.mjs",
    "test:beta": "node scripts/check-beta-artifacts.mjs",
    "test:production-deploy": "node scripts/check-production-deploy.mjs",
    "test:mysql": "node scripts/mysql-smoke-test.mjs",
    "test:acceptance:admin": "node scripts/acceptance-admin-mvp.mjs",
    "test:acceptance:store": "node scripts/acceptance-store-mvp.mjs",
    "test:miniapp-release": "node scripts/check-miniapp-release.mjs",
    "test:acceptance:production": "node scripts/acceptance-production.mjs"
  },
  "devDependencies": {
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "js-yaml": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
