.payment-hero {
  margin: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #4A121E, #8B1A2B);
  box-shadow: 0 22rpx 56rpx rgba(139, 26, 43, .22);
}
.light {
  color: rgba(255, 255, 255, .76);
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 12rpx;
}
.hero-sub {
  color: rgba(255, 255, 255, .78);
  margin-top: 18rpx;
}
.payment-card {
  margin-top: -4rpx;
}
.amount-label {
  color: #7B7074;
  font-size: 26rpx;
}
.status-row {
  display: flex;
  justify-content: space-between;
  color: #7B7074;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.tax-box {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(201, 169, 110, .14);
  color: #8B1A2B;
}
.items-box {
  margin-top: 28rpx;
}
.section-title {
  font-weight: 700;
  color: #211A1D;
  margin-bottom: 8rpx;
}
.item-row {
  padding: 18rpx 0;
  border-top: 1px solid #E8DED4;
}
.error-text {
  margin-bottom: 20rpx;
  color: #8B1A2B;
  font-weight: 700;
}
.pay-button {
  margin-top: 36rpx;
  background: linear-gradient(135deg, #8B1A2B, #A72A3E);
  box-shadow: 0 16rpx 36rpx rgba(139, 26, 43, .28);
}
