.payment-hero {
  margin: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  color: #1F2328;
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-left: 8rpx solid #1677FF;
  box-shadow: 0 22rpx 56rpx rgba(31, 35, 40, .08);
}
.light {
  color: #9CA3AF;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 12rpx;
}
.hero-sub {
  color: #4B5563;
  margin-top: 18rpx;
}
.payment-card {
  margin-top: -4rpx;
}
.amount-label {
  color: #9CA3AF;
  font-size: 26rpx;
}
.status-row {
  display: flex;
  justify-content: space-between;
  color: #4B5563;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.tax-box {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F5F7FA;
  color: #4B5563;
}
.items-box {
  margin-top: 28rpx;
}
.section-title {
  font-weight: 700;
  color: #1F2328;
  margin-bottom: 8rpx;
}
.item-row {
  padding: 18rpx 0;
  border-top: 1px solid #E5E7EB;
}
.error-text {
  margin-bottom: 20rpx;
  color: #EF4444;
  font-weight: 700;
}
.pay-button {
  margin-top: 36rpx;
  background: #1677FF;
  box-shadow: 0 16rpx 36rpx rgba(22, 119, 255, .24);
}
