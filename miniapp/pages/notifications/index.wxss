.container {
  padding: 0 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  padding: 20rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1677FF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1677FF;
  border-radius: 2rpx;
}

.badge {
  display: inline-block;
  background: #EF4444;
  color: #fff;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
  vertical-align: middle;
  min-width: 32rpx;
  text-align: center;
  line-height: 32rpx;
}

.notification-list {
  margin-top: 20rpx;
}

.notification-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.notification-item.unread {
  border-left: 6rpx solid #1677FF;
}

.notification-item.read {
  border-left: 6rpx solid transparent;
}

.notification-dot {
  position: absolute;
  top: 28rpx;
  left: 16rpx;
  width: 12rpx;
  height: 12rpx;
  background: #1677FF;
  border-radius: 50%;
}

.notification-content {
  padding-left: 16rpx;
}

.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.notification-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2328;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.notification-body {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notification-type {
  margin-top: 12rpx;
}

.type-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #1677FF;
  background: rgba(22, 119, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #1677FF;
  padding: 12rpx 40rpx;
  border: 1rpx solid #1677FF;
  border-radius: 32rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}
