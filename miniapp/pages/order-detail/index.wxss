.muted { color: #666; font-size: 28rpx; }
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}
.tag-pending { background: #fdf6ec; color: #e6a23c; }
.tag-accept { background: #dbeafe; color: #409eff; }
.tag-delivery { background: #ecf5ff; color: #1677ff; }
.tag-done { background: #e1f3d8; color: #67c23a; }
.item-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.primary-btn {
  background: #1677ff;
  color: #fff;
  border-radius: 8rpx;
  border: none;
  font-size: 30rpx;
  padding: 16rpx 0;
}
.cancel-btn {
  background: #fff;
  color: #e6a23c;
  border: 2rpx solid #e6a23c;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
}
