<view wx:if="{{errorText}}" class="card" style="color: #9b1c31;">{{errorText}}</view>

<view wx:if="{{hasDetail}}" class="card">
  <view style="font-size: 36rpx; font-weight: 700;">订单详情</view>
  <view class="muted" style="margin-top: 16rpx;">{{detail.orderNo}}</view>
  <view style="display: flex; margin-top: 20rpx;">
    <text class="tag tag-{{detail.orderTagClass}}">{{detail.orderStatusLabel}}</text>
    <text class="tag tag-{{detail.payTagClass}}" style="margin-left: 12rpx;">{{detail.payStatus}}</text>
  </view>
  <view class="price" style="margin-top: 24rpx;">¥{{detail.payableAmount}}</view>
  <view wx:if="{{detail.receiverName}}" class="muted" style="margin-top: 16rpx;">
    收货人：{{detail.receiverName}} {{detail.receiverMobile}}
  </view>
  <view wx:if="{{detail.receiverAddress}}" class="muted" style="margin-top: 8rpx;">
    地址：{{detail.receiverAddress}}
  </view>
  <view wx:if="{{hasItems}}" style="margin-top: 24rpx;">
    <view style="font-weight: 700; margin-bottom: 12rpx; font-size: 28rpx;">商品明细</view>
    <view wx:for="{{detail.items}}" wx:key="skuId" class="item-row">
      <text>{{item.skuName}} ×{{item.qty}}</text>
      <text style="color: #9b1c31;">¥{{item.displayAmount}}</text>
    </view>
  </view>
  <view wx:if="{{detail.createdAt}}" class="muted" style="margin-top: 20rpx;">
    创建时间：{{detail.createdAt}}
  </view>
</view>

<button
  wx:if="{{detail.orderStatus === 'WAIT_DELIVERY' || detail.orderStatus === 'DELIVERING'}}"
  class="primary-btn"
  style="margin: 20rpx; width: calc(100% - 40rpx);"
  bindtap="confirmReceipt"
>
  确认收货
</button>

<button class="primary" style="margin: 20rpx; width: calc(100% - 40rpx);" bindtap="goBack">返回订单列表</button>
