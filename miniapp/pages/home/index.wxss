.muted {
  color: #666;
  font-size: 28rpx;
}
.outline {
  width: 100%;
  background: transparent;
  color: #9b1c31;
  border: 2rpx solid #9b1c31;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
}
.stepper {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 36rpx;
}
.stepper[disabled] {
  opacity: 0.4;
  border-color: #eee;
}
.field {
  width: 100%;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #f5f5f5;
}
.search-btn {
  background: #1677ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  line-height: 1.4;
}
.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}
