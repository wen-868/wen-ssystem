.card {
  margin: 20rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.muted {
  color: #666;
  font-size: 28rpx;
}
.price {
  color: #9b1c31;
  font-size: 40rpx;
  font-weight: 700;
}
.primary {
  width: 100%;
  background: #9b1c31;
  color: white;
  border-radius: 8rpx;
  border: none;
  font-size: 30rpx;
  padding: 16rpx 0;
}
.outline {
  width: 100%;
  background: transparent;
  color: #9b1c31;
  border: 2rpx solid #9b1c31;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
}
.stepper {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 36rpx;
}
.stepper[disabled] {
  opacity: 0.4;
  border-color: #eee;
}
.field {
  width: 100%;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}