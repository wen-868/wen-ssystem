<view class="card">
  <view class="muted">首页</view>
  <view style="font-size: 42rpx; font-weight: 700; margin-top: 12rpx;">智享商城</view>
  <view class="muted" style="margin-top: 20rpx;">商品浏览、一键下单和门店履约演示。</view>
  <view wx:if="{{errorText}}" style="margin-top: 20rpx; color: #9b1c31;">{{errorText}}</view>
</view>

<view wx:for="{{products}}" wx:key="skuId" class="card">
  <view style="font-size: 34rpx; font-weight: 700;">{{item.name}}</view>
  <view class="muted" style="margin-top: 12rpx;">{{item.skuName}}</view>
  <view class="price" style="margin-top: 18rpx;">¥{{item.price}}</view>
  <view class="muted" style="margin-top: 12rpx;">可售库存：{{item.availableQty}}，价格类型：{{item.priceType}}</view>
  <view style="display: flex; align-items: center; margin-top: 20rpx;">
    <text style="font-size: 28rpx; margin-right: 16rpx;">数量：</text>
    <button class="stepper" data-sku-id="{{item.skuId}}" data-delta="-1" bindtap="changeQty" disabled="{{item._qty <= 1}}">-</button>
    <text style="font-size: 32rpx; margin: 0 20rpx; min-width: 40rpx; text-align: center;">{{item._qty || 1}}</text>
    <button class="stepper" data-sku-id="{{item.skuId}}" data-delta="1" bindtap="changeQty" disabled="{{item._qty >= item.availableQty}}">+</button>
  </view>
  <button class="primary" style="margin-top: 28rpx;" data-sku-id="{{item.skuId}}" bindtap="handleBuy">加入下单</button>
</view>

<view wx:if="{{!loading && !products.length && !errorText}}" class="card">
  <view class="muted">暂无在售商品，请先让管理员上架。</view>
</view>

<view class="card" wx:if="{{cartItems.length > 0}}" style="background: #fefaf0; border: 2rpx solid #e6a23c;">
  <view style="font-size: 34rpx; font-weight: 700; color: #e6a23c;">待下单清单</view>
  <view wx:for="{{cartItems}}" wx:key="skuId" style="display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 28rpx;">
    <text>{{item.name}} ×{{item.qty}}</text>
    <text style="color: #9b1c31;">¥{{item.subtotal}}</text>
  </view>
  <view style="font-weight: 700; text-align: right; margin-top: 16rpx; font-size: 32rpx;">
    合计：¥{{cartTotal}}
  </view>
  <view style="margin-top: 20rpx;">
    <input class="field" placeholder="收货人姓名" value="{{receiverName}}" bindinput="onNameInput" />
    <input class="field" placeholder="联系电话" value="{{receiverMobile}}" bindinput="onMobileInput" type="number" maxlength="11" />
    <input class="field" placeholder="收货地址（选填）" value="{{receiverAddress}}" bindinput="onAddrInput" />
  </view>
  <view style="display: flex; gap: 16rpx; margin-top: 24rpx;">
    <button class="outline" style="flex:1" bindtap="clearCart">清空</button>
    <button class="primary" style="flex:1" loading="{{submitting}}" bindtap="submitCart">提交订单</button>
  </view>
</view>