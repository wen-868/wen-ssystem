<view style="{{themeCssVars}}">
<view class="card">
  <view class="muted">订单</view>
  <view style="font-size: 42rpx; font-weight: 700; margin-top: 12rpx;">我的订单</view>
  <view wx:if="{{errorText}}" style="margin-top: 20rpx; color: #9b1c31;">{{errorText}}</view>
  <button class="primary" loading="{{loading}}" style="margin-top: 32rpx;" bindtap="handleTap">刷新订单</button>
</view>

<view wx:for="{{orders}}" wx:key="orderNo" class="card" bindtap="goDetail" data-order-no="{{item.orderNo}}">
  <view style="display: flex; justify-content: space-between; align-items: center;">
    <view style="font-weight: 700; font-size: 30rpx;">{{item.orderNo}}</view>
    <text style="font-size: 28rpx; color: #9b1c31;">&#9654;</text>
  </view>
  <view style="display: flex; margin-top: 16rpx; gap: 12rpx;">
    <text class="tag tag-{{item.orderTagClass}}">{{item.orderStatusLabel}}</text>
    <text class="tag tag-{{item.payTagClass}}">{{item.payStatus}}</text>
  </view>
  <view class="muted" style="margin-top: 14rpx;">履约方式：{{item.fulfillmentLabel}}</view>
  <view class="price" style="margin-top: 14rpx;">¥{{item.payableAmount}}</view>
  <view class="muted" style="margin-top: 10rpx; font-size: 24rpx;">{{item.createdAt}}</view>
</view>

<view wx:if="{{showEmpty}}" class="card">
  <view class="muted">暂无订单，请先在首页下单。</view>
</view>
</view>
