<view class="card">
  <view class="muted">订单</view>
  <view style="font-size: 42rpx; font-weight: 700; margin-top: 12rpx;">订单</view>
  <view class="muted" style="margin-top: 20rpx;">查看小程序订单履约状态。</view>
  <view wx:if="{{errorText}}" style="margin-top: 20rpx; color: #9b1c31;">{{errorText}}</view>
  <button class="primary" loading="{{loading}}" style="margin-top: 32rpx;" bindtap="handleTap">刷新订单</button>
</view>

<view wx:for="{{orders}}" wx:key="orderNo" class="card">
  <view style="font-weight: 700;">订单号：{{item.orderNo}}</view>
  <view class="muted" style="margin-top: 12rpx;">履约方式：{{item.fulfillmentType}}</view>
  <view class="muted" style="margin-top: 12rpx;">订单状态：{{item.orderStatus}}</view>
  <view class="muted" style="margin-top: 12rpx;">支付状态：{{item.payStatus}}</view>
  <view class="price" style="margin-top: 16rpx;">¥{{item.payableAmount}}</view>
</view>

<view wx:if="{{!loading && !orders.length && !errorText}}" class="card">
  <view class="muted">暂无订单，请先在首页一键下单。</view>
</view>
