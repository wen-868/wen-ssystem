.card {
  margin: 20rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.muted { color: #666; font-size: 28rpx; }
.price { color: #9b1c31; font-size: 36rpx; font-weight: 700; }
.primary {
  width: 100%;
  background: #9b1c31;
  color: white;
  border-radius: 8rpx;
  border: none;
  font-size: 30rpx;
  padding: 16rpx 0;
}
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}
.tag-pending { background: #fdf6ec; color: #e6a23c; }
.tag-accept { background: #dbeafe; color: #409eff; }
.tag-delivery { background: #ecf5ff; color: #1677ff; }
.tag-done { background: #e1f3d8; color: #67c23a; }