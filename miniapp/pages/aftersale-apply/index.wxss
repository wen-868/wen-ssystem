/* ========== 章节标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2328);
  margin-bottom: 20rpx;
}

/* ========== 售后类型 ========== */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.type-option {
  padding: 20rpx;
  border: 2rpx solid var(--border-normal, #E5E7EB);
  border-radius: 16rpx;
  background: var(--bg-soft, #F0F2F5);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.type-option.active {
  border-color: var(--color-primary, #1677FF);
  background: var(--color-primary-soft, #E6F4FF);
}
.type-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2328);
}
.type-desc {
  font-size: 22rpx;
}

/* ========== 售后商品 ========== */
.apply-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-normal, #E5E7EB);
}
.apply-item:last-of-type {
  border-bottom: none;
}
.apply-item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.apply-item-name {
  font-size: 28rpx;
  font-weight: 600;
}
.apply-item-qty {
  display: flex;
  align-items: center;
}
.qty-text {
  font-size: 28rpx;
  min-width: 60rpx;
  text-align: center;
  font-weight: 600;
}
.refund-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-normal, #E5E7EB);
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 原因选择 ========== */
.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.reason-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--border-normal, #E5E7EB);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #4B5563);
  background: var(--bg-soft, #F0F2F5);
}
.reason-tag.active {
  border-color: var(--color-primary, #1677FF);
  color: var(--color-primary, #1677FF);
  background: var(--color-primary-soft, #E6F4FF);
}

/* ========== 详细说明 ========== */
.detail-input {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid var(--border-normal, #E5E7EB);
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--bg-soft, #F0F2F5);
}

/* ========== 图片上传 ========== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}
.upload-image {
  width: 100%;
  height: 100%;
}
.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.image-add {
  border: 2rpx dashed var(--border-normal, #E5E7EB);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-soft, #F0F2F5);
}
.add-icon {
  font-size: 56rpx;
  color: var(--text-muted, #9CA3AF);
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* ========== 提交按钮 ========== */
.submit-wrap {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.submit-btn {
  width: 100%;
  font-size: 32rpx;
  padding: 24rpx 0;
  line-height: 1.4;
}
