/* ========== Tab栏 ========== */
.tab-bar {
  display: flex;
  background: var(--bg-card, #FFFFFF);
  border-bottom: 1rpx solid var(--border-normal, #E5E7EB);
  position: sticky;
  top: 0;
  z-index: 50;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-muted, #9CA3AF);
  position: relative;
}
.tab-item.active {
  color: var(--color-primary, #1677FF);
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary, #1677FF);
  border-radius: 2rpx;
}

/* ========== 空状态 ========== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ========== 售后卡片 ========== */
.aftersale-card {
  cursor: pointer;
}
.aftersale-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.aftersale-no {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2328);
}
.aftersale-type {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}
.aftersale-reason {
  font-size: 26rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.aftersale-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-normal, #E5E7EB);
}
.aftersale-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-price, #9b1c31);
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 32rpx 0;
}

/* ========== 浮动按钮 ========== */
.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  background: var(--color-primary, #1677FF);
  color: #fff;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
  z-index: 100;
}
.float-btn-text {
  font-size: 26rpx;
  font-weight: 600;
}
