page {
  background: #F5F3EF;
  color: #211A1D;
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(73, 48, 40, .08);
}
.primary {
  background: #8B1A2B;
  color: #fff;
  border-radius: 999rpx;
}
.price {
  color: #8B1A2B;
  font-weight: 700;
  font-size: 40rpx;
}
.gold {
  color: #C9A96E;
}
.muted {
  color: #7B7074;
}
