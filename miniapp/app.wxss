@import "./styles/tokens.wxss";

page {
  background: #FFFFFF;
  color: #1F2328;
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}
.card {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(31, 35, 40, .08);
}
.primary {
  background: #1677FF;
  color: #FFFFFF;
  border-radius: 999rpx;
}
.price {
  color: #1F2328;
  font-weight: 700;
  font-size: 40rpx;
}
.gold {
  color: #1677FF;
}
.muted {
  color: #9CA3AF;
}
