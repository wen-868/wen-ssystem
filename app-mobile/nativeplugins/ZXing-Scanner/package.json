{
  "name": "ZXing-Scanner",
  "version": "1.0.0",
  "description": "智享全链 App 条码扫码原生插件（基于 ZXing），支持商品条码（EAN-13/EAN-8/UPC）、二维码（QR_CODE）、追溯码识别",
  "keywords": [
    "zxing",
    "scanner",
    "barcode",
    "qrcode",
    "uni-app",
    "native-plugin"
  ],
  "provider": "阿澈",
  "license": "MIT",
  "platforms": {
    "android": {
      "package": "io.zhixiang.scanner.ZXingScannerModule",
      "minSdkVersion": 21,
      "permissions": [
        "android.permission.CAMERA",
        "android.hardware.camera.autofocus"
      ]
    }
  },
  "dependencies": {
    "zxing-core": "3.5.3"
  }
}