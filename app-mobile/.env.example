# app-mobile 环境变量示例
# 用法：复制为 .env 后按需要覆盖（.env 不入库，仅本示例入库）

# API 基址
# - H5 端：留空则用相对路径 /api（由 vite dev proxy 转发，生产由 nginx 处理）
# - App / 小程序端：构建期注入，未配置时回退占位地址
# VITE_API_BASE=https://api.onepan.cn/api

# H5 本地开发代理目标（默认 http://localhost:8080）
# VITE_PROXY_TARGET=http://localhost:8080

# 演示账号（一键「演示登录」自动填入表单并自动提交登录；
# 账号被公网爆破锁定时自动降级为免密演示通道 /api/admin/auth/demo-login）
# 演示账号，可替换。凭据唯一出处：src/api/modules/auth.ts 的 DEMO_ACCOUNT / DEMO_PASSWORD
VITE_DEMO_ACCOUNT=demo
VITE_DEMO_PASSWORD=Demo@2026
