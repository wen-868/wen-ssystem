# ============================================================================
# 智享AI底座 — 环境变量示例
# ============================================================================
# 使用说明：
#   1. 复制本文件为 .env：`cp .env.example .env`
#   2. 替换所有敏感字段（标注 <请替换> 的项）为真实值
#   3. ENCRYPTION_KEY 部署前请重新生成：
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   4. 本文件可提交到仓库，.env 文件禁止提交
# ============================================================================

# ---- 服务配置 ----
PORT=3016
NODE_ENV=development
# 系统形态：mgmt=管理系统 / ops=运营系统（C9 路由维度；两形态共用同一底座代码）
SYSTEM_SCOPE=mgmt

# ---- 数据库配置（与现有 backend 共享 MySQL 实例，库名必须一致）----
# 注意：DB_DATABASE 必须与 backend/.env 的 DB_NAME 保持一致（默认 liquor_inventory）
# 生产环境 DB_USERNAME 应使用专用账号 zhixiang_app，本地开发可用 root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=<请替换为真实密码>
DB_DATABASE=liquor_inventory

# ---- Redis 配置（共享现有实例，使用 DB1 存对话记忆避免冲突）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ---- 后端服务对接（现有 Express.js 单体后端 API 基础地址）----
BACKEND_API_BASE=http://127.0.0.1:8080
BACKEND_API_TIMEOUT=15000

# ---- AI 服务商配置 ----
# 默认服务商：glm（智谱免费） | deepseek | ollama
# glm = 智谱 GLM-4-Flash 免费模型（open.bigmodel.cn，免费申请 API Key，无需充值）
DEFAULT_MODEL_PROVIDER=glm

# 智谱 GLM 配置（免费默认模型 glm-4-flash，OpenAI 兼容）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=<请替换为智谱开放平台免费申请的 API Key>
GLM_MODEL=glm-4-flash

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<请替换为真实 API Key>
DEEPSEEK_MODEL=deepseek-chat

# Ollama 配置（本地模型，可选；OpenAI 兼容端点需带 /v1）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=30000

# ---- AI 调用参数 ----
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=2048

# ---- 安全配置 ----
# API Key 加密密钥（32 字节 hex，AES-256-GCM）
# 生成命令：openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 本值为占位符：部署脚本 deploy/ai-base-deploy.sh 会自动生成并写入 .env；本地复制后请先替换
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX_KEY

# JWT 密钥（与现有 backend 共享，用于解析租户 token）
JWT_SECRET=<请替换为与 backend 一致的 JWT 密钥>

# CSRF 密钥（与 backend/.env 的 CSRF_SECRET 一致；写操作请求后端时需要计算 x-csrf-token，
# 缺失时自动回退 JWT_SECRET，与 backend/src/middleware/csrf.ts 的 generateCsrfToken 逻辑一致）
CSRF_SECRET=<请替换为与 backend 一致的 CSRF 密钥>

# ---- 限流配置 ----
# 每租户每分钟最大请求数
RATE_LIMIT_PER_MINUTE=60

# ---- 对话记忆配置 ----
# 对话历史保留轮数
MEMORY_MAX_ROUNDS=20
# 待确认操作 TTL（秒）
CONFIRMATION_TTL=300

# ---- RAG 知识库配置（可选，R70-21）----
# OpenAI 兼容 embedding 服务（默认指向本地 Ollama 的 /v1 兼容端点）
# 配置 EMBEDDING_MODEL（如 nomic-embed-text）后启用 RAG 检索增强；
# 未配置时 RAG 自动降级禁用（对话不报错，仅跳过知识库增强）。
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# embedding 单次请求超时（毫秒）
EMBEDDING_TIMEOUT_MS=30000

# ---- 运营闭环配置（完善度 P2）----
# AI 用量阈值告警：日费用超过阈值（元）触发推送；0 或留空 = 不按费用告警
USAGE_DAILY_ALERT_COST=0
# 日 Token 阈值（可选）；0 或留空 = 不按 Token 告警
USAGE_DAILY_ALERT_TOKENS=0
# 健康监控开关（true=每 5 分钟自检数据库/后端，状态翻转推送告警；false=禁用）
HEALTH_MONITOR_ENABLED=true
# 启动时自动注册 API 目录工具（总台注册表→AI 技能）；false 时可用管理接口按需注册
ENABLE_API_CATALOG_TOOLS=false

# ---- 日志配置 ----
LOG_LEVEL=info
