# ============================================================================
# 智享全链管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================================

# ---- 运行环境 ----
# 可选值：production / development / test
NODE_ENV=production

# ---- 服务端口 ----
PORT=8080

# ---- 日志级别 ----
# 可选值：debug / info / warn / error（生产环境建议 info）
LOG_LEVEL=info

# ---- JWT 认证 ----
# 必填。用于签发和验证 Token，请使用随机生成的强密钥
JWT_SECRET=CHANGE_ME_TO_RANDOM_JWT_SECRET

# ---- 安全 ----
# 必填。用于 CSRF Token 签名，请使用随机生成的强密钥（未配置时回退到 JWT_SECRET）
CSRF_SECRET=CHANGE_ME_TO_RANDOM_CSRF_SECRET

# ---- 运营系统服务账号（统一管理后台方案 §5.4 / P0）----
# 供 POST /api/admin/auth/service-token 换发服务 JWT；须与运营系统 OPS_MS_CLIENT_ID/SECRET 一致
SERVICE_ACCOUNT_CLIENT_ID=
SERVICE_ACCOUNT_CLIENT_SECRET=

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhixiang_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD
DB_NAME=liquor_inventory
# 连接池（可选，有默认值）
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=0
DB_ACQUIRE_TIMEOUT=10000

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 完整连接 URL（可选，配置后优先于 HOST+PORT）
REDIS_URL=redis://127.0.0.1:6379

# ---- 域名配置 ----
DOMAIN=onepan.cn
API_DOMAIN=api.onepan.cn
ADMIN_DOMAIN=admin.onepan.cn
MERCHANT_DOMAIN=m.onepan.cn
# CORS 允许的域名（逗号分隔，不配置则使用上面域名的https版本）
CORS_ORIGINS=https://admin.onepan.cn,https://m.onepan.cn

# ---- 腾讯云 ----
TENCENT_CLOUD_APPID=your-tencent-cloud-appid

# ---- 微信小程序 ----
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
# 微信别名（与上面一致，兼容旧代码）
WX_APPID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret

# ---- 微信支付 ----
# WECHAT_MCH_ID：env.ts L94 声明的微信支付商户号，未配置时默认空字符串，下单接口会报错
WECHAT_MCH_ID=改成你的微信支付商户号
# WECHAT_PAY_SERIAL_NO：env.ts L97 声明的商户API证书序列号，从商户平台下载的apiclient_cert.pem中提取
WECHAT_PAY_SERIAL_NO=改成你的商户API证书序列号
# WECHAT_PAY_PRIVATE_KEY_PATH：env.ts L100 声明的商户私钥 .pem 文件绝对路径
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# WECHAT_PAY_PLATFORM_CERT_PATH：env.ts L103 声明的微信支付平台证书 .pem 绝对路径（用于验签回调）
WECHAT_PAY_PLATFORM_CERT_PATH=/path/to/platform_cert.pem
# WECHAT_PAY_API_V3_KEY：env.ts L106 声明的微信支付API v3密钥（32位随机字符串，必须与商户平台API安全中配置一致），用于支付回调解密和v3接口签名，未配置时默认空字符串
WECHAT_PAY_API_V3_KEY=改成你的微信支付APIv3密钥32位随机字符串
# WECHAT_PAY_NOTIFY_URL：env.ts L109 声明的支付回调通知URL，微信支付成功后会POST到此地址
WECHAT_PAY_NOTIFY_URL=https://api.onepan.cn/api/miniapp/pay/notify
# 微信支付兼容别名（优先读别名值，别名空则回退到上方主名称）
# WX_MCH_ID：env.ts L118 声明的微信支付商户号兼容别名，未配置时回退 WECHAT_MCH_ID
WX_MCH_ID=改成你的微信支付商户号（与WECHAT_MCH_ID保持一致）
# WX_API_KEY：env.ts L121 声明的微信支付API密钥兼容别名，未配置时回退 WECHAT_PAY_API_V3_KEY
WX_API_KEY=改成你的微信支付APIv3密钥（与WECHAT_PAY_API_V3_KEY保持一致）

# ---- 即时零售 ----
# 可选。Mock 模式开关
INSTANT_RETAIL_MOCK=

# ---- Mock 数据库 ----
# 开发/测试时使用，生产环境必须为 false
USE_MOCK_DB=false

# ---- 飞书通知 ----
# 飞书群机器人 webhook — 用于发送工作汇报
FEISHU_WEBHOOK_URL=
# 飞书告警 webhook — 用于发送系统告警（P0 错误等）
# 如未配置，将回退使用 FEISHU_WEBHOOK_URL
FEISHU_ALERT_WEBHOOK_URL=

# ---- 推送服务 ----
# 极光推送（JPush）：向 Android/iOS 端 APP 推送即时零售/订单消息
# JPUSH_APP_KEY：env.ts L143 声明，未配置时默认空字符串，JPush 通道降级报错未配置
JPUSH_APP_KEY=改成你的极光推送AppKey（不用则留空）
# JPUSH_MASTER_SECRET：env.ts L146 声明，用于服务端调用 JPush REST API 下发消息
JPUSH_MASTER_SECRET=改成你的极光推送MasterSecret（不用则留空）
# Firebase Cloud Messaging：向海外 Android/iOS 端推送消息
# FCM_PROJECT_ID：env.ts L149 声明，未配置时默认空字符串，FCM 通道降级
FCM_PROJECT_ID=改成你的Firebase项目ID（不用则留空）
# FCM_ACCESS_TOKEN：env.ts L152 声明，用于服务端调用 FCM HTTP v1 API 下发消息
FCM_ACCESS_TOKEN=改成你的Firebase服务账号短期Access Token或长期服务账号JSON（不用则留空）
# 华为推送（HMS Push Kit）：向华为系手机端推送消息
# HMS_APP_ID：env.ts L155 声明，未配置时默认空字符串，HMS 通道降级
HMS_APP_ID=改成你的华为开发者联盟应用AppId（不用则留空）
# HMS_APP_SECRET：env.ts L158 声明，用于服务端调用 HMS Push Kit API 下发消息
HMS_APP_SECRET=改成你的华为推送AppSecret（不用则留空）
